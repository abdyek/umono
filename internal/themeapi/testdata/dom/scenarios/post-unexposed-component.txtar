A built-in in a component that is not exposed belongs to the scope it is
rendered in: HIDDEN's link is post LINK from the layout and post CARD LINK
from CARD.
-- contract.toml --
schema = "https://umono.dev/schemas/theme-contract/v1"
id = "test/scenario"
version = "v1.0"

[[layouts]]
id = "post"
source = '''
{{ HIDDEN }}

{{ CARD }}
'''

[[components]]
name = "HIDDEN"
expose = false
source = '''
{{ LINK text = "Hidden" url = "/hidden" }}
'''

[[components]]
name = "CARD"
expose = true
source = '''
{{ HIDDEN }}
'''
-- attributes.toml --
schema = "https://umono.dev/schemas/theme-attributes/v1"

[address."post LINK"]
class = "post--LINK"

[address."post CARD LINK"]
class = "post--CARD--LINK"
-- page.comp --
{{ UMONO_LAYOUT }}
