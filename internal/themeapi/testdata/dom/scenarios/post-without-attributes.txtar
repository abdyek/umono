Without attributes.toml the runtime gives no hook: neither <umono-root> nor
any built-in gets an attribute.
-- contract.toml --
schema = "https://umono.dev/schemas/theme-contract/v1"
id = "test/scenario"
version = "v1.0"

[[layouts]]
id = "post"
source = '''
~ title = ""
# {{ title }}

{{ LINK text = "Layout" url = "/layout" }}

{{ CARD }}
'''

[[components]]
name = "CARD"
expose = true
source = '''
{{ LINK text = "Card" url = "/card" }}
'''
-- page.comp --
{{ UMONO_LAYOUT title = "Without attributes" }}
