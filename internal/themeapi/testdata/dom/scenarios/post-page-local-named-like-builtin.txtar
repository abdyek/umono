A local named LINK overrides the built-in in the page: the call is no
built-in, so the hook is not called. The layout's LINK is still post LINK.
-- contract.toml --
schema = "https://umono.dev/schemas/theme-contract/v1"
id = "test/scenario"
version = "v1.0"

[[layouts]]
id = "post"
source = '''
~ content = NO_MATTER
{{ LINK text = "Layout" url = "/layout" }}

{{ content }}
'''
-- attributes.toml --
schema = "https://umono.dev/schemas/theme-attributes/v1"

[address."post LINK"]
class = "post--LINK"
-- page.comp --
{{ UMONO_LAYOUT content = TEXT }}

~ TEXT
{{ LINK }}

~ LINK
Not a link
